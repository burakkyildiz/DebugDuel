NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Public widget key. Configure the matching secret in Supabase Auth CAPTCHA
# and in the server-only variable below when Auth IP forwarding is enabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only, matching the widget. Required when Auth IP forwarding is enabled.
TURNSTILE_SECRET_KEY=
SUPABASE_SECRET_KEY=server-only-placeholder
# Enable only on Vercel after enabling Supabase Auth IP Address Forwarding.
AUTH_IP_FORWARDING_ENABLED=false
SUPABASE_AUTH_SECRET_KEY=server-only-auth-forwarding-placeholder
GUEST_SESSION_SECRET=replace-with-a-strong-random-secret
RATE_LIMIT_HASH_SECRET=replace-with-a-separate-random-secret
COMMAND_RECEIPT_ENCRYPTION_KEY=server-only-32-byte-key-placeholder
